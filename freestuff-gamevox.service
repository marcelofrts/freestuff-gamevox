[Unit]
Description=FreeStuff GameVox Bot
After=network.target

[Service]
Type=simple
User=root
# Ajuste para a pasta onde você clonou o projeto no servidor
WorkingDirectory=/opt/freestuff-gamevox
ExecStart=/usr/bin/python3 /opt/freestuff-gamevox/main.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
