# URL do Webhook do canal no GameVox
GAMEVOX_WEBHOOK_URL=

# Intervalo de checagem em minutos
CHECK_INTERVAL_MINUTES=15

# Lojas permitidas (apenas Steam, Epic Games e GOG)
ALLOWED_STORES=steam,epic games,gog

# Filtrar somente jogos que podem ser resgatados/baixados no Brasil (true/false)
ONLY_BRAZIL=true

# Tipo de conteúdo: game (apenas jogos completos, ignora skins e DLCs soltas)
TYPE_FILTER=game

# Plataforma base
PLATFORM_FILTER=pc

# Menção opcional de cargo (ex: @everyone, @here ou deixe vazio)
NOTIFY_ROLE=
