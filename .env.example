# URL do Webhook do canal no GameVox
# Obtenha clicando com botão direito no canal de texto -> Editar Canal -> Integrações / Webhooks -> Criar Webhook
GAMEVOX_WEBHOOK_URL=

# Intervalo de verificação em minutos (ex: 15)
CHECK_INTERVAL_MINUTES=15

# Plataforma para filtrar:
# Opções: pc, steam, epic-games-store, gog, ps4, ps5, xbox-one, xbox-series-xs, all
PLATFORM_FILTER=pc

# Tipo de conteúdo para monitorar:
# Opções: game (somente jogos completos), loot (itens e DLCs), beta, all
TYPE_FILTER=game

# Notificação por menção (opcional):
# Exemplo: @everyone, @here, ou deixe vazio se não quiser marcar ninguém
NOTIFY_ROLE=
